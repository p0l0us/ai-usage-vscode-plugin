{
  "name": "ai-usage-service",
  "version": "1.0.21",
  "description": "Claude Code and Codex account manager: saves logins as profiles, switches between them, sends keep-alives and rotates accounts at their limits, as a background service with the ai-usage command and an MCP server. Works without VS Code; the AI Usage VS Code extension uses it too.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai",
    "anthropic",
    "usage",
    "rate-limit",
    "account",
    "rotation",
    "cli",
    "mcp"
  ],
  "homepage": "https://github.com/p0l0us/ai-usage-vscode-plugin/tree/main/service#readme",
  "bugs": {
    "url": "https://github.com/p0l0us/ai-usage-vscode-plugin/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/p0l0us/ai-usage-vscode-plugin.git",
    "directory": "service"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "bin": {
    "ai-usage": "bin/ai-usage.js"
  },
  "files": [
    "bin",
    "out",
    "!out/**/*.map",
    "README.md",
    "LICENSE",
    "bridge/src",
    "bridge/package.json"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test test/*.test.js",
    "start": "node bin/ai-usage.js daemon",
    "prepublishOnly": "npm --prefix .. test"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "typescript": "^5.9.2"
  }
}
